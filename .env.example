# MAPS startup
MAPS_DEFAULT_PROVIDER=libre
MAPS_ENABLED_PROVIDERS=libre,mapbox,google,apple
MAPS_CACHE_TTL_SECONDS=86400
MAPS_PROVIDER_PROXY_URL=

# Libre provider: OSM, Overture, PMTiles, MapLibre-compatible styles.
NEXT_PUBLIC_MAPLIBRE_STYLE_URL=
NEXT_PUBLIC_MAPLIBRE_STYLE_DARK_URL=
OSM_OVERPASS_ENDPOINT=https://overpass-api.de/api/interpreter
OVERTURE_PLACES_PATH=
OVERTURE_BUILDINGS_PATH=
PMTILES_BASE_URL=

# Mapbox provider.
# Browser-render tokens must be public tokens with the minimum allowed scope.
NEXT_PUBLIC_MAPBOX_TOKEN=
MAPBOX_ACCESS_TOKEN=
MAPBOX_STYLE_URL=
NEXT_PUBLIC_MAPBOX_STYLE_URL=
NEXT_PUBLIC_MAPBOX_TILESET_ID=
NEXT_PUBLIC_MAPBOX_SOURCE_LAYER=

# Google provider.
# Keep Places/search keys server-side unless the product explicitly needs browser use.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_API_KEY=
GOOGLE_PLACES_API_KEY=

# Apple MapKit provider.
# Private keys stay server-side. Browser clients should request short-lived tokens
# from your app's token endpoint instead of reading private values directly.
APPLE_MAPKIT_TEAM_ID=
APPLE_MAPKIT_KEY_ID=
APPLE_MAPKIT_PRIVATE_KEY=
NEXT_PUBLIC_APPLE_MAPKIT_TOKEN_ENDPOINT=/api/maps/apple-token

# Attribution and policy links rendered by products.
MAPS_ATTRIBUTION_URL=
MAPS_PRIVACY_URL=
